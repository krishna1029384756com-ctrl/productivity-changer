{
  "manifest_version": 3,
  "name": "Productivity Changer",
  "version": "0.1.0",
  "description": "Personal productivity extension",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Productivity Changer"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/blocker.js", "content/darkmode.js"],
      "run_at": "document_end"
    }
  ]
}
