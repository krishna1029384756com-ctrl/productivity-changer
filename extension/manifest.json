{
  "manifest_version": 3,
  "name": "Productivity Changer",
  "version": "1.0",
  "description": "Block distractions, focus, manage tabs, and take notes.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "alarms",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/blocker.js", "content/darkmode.js"],
      "run_at": "document_start"
    }
  ]
}
